{
  "id": "root",
  "type": "column",
  "preview": "layouts/vx-code.svg",
  "titlebar": "none",
  "traffic_lights": [
    12,
    12
  ],
  "background": "canvas",
  "terminal_padding": [
    10,
    12
  ],
  "children": [
    {
      "id": "titlebar",
      "type": "block",
      "content": {
        "mod": "vx-titlebar"
      },
      "size": {
        "px": 38
      },
      "window_drag": true
    },
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "activity",
          "type": "block",
          "content": {
            "mod": "vx-activity"
          },
          "size": {
            "px": 48
          }
        },
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 300
          },
          "min": 200,
          "max": 640,
          "background": "chrome",
          "children": [
            {
              "id": "sidebar-title",
              "type": "block",
              "content": {
                "mod": "vx-activity",
                "props": {
                  "title": true
                }
              },
              "size": {
                "px": 32
              }
            },
            {
              "id": "sidebar-views",
              "type": "stack",
              "active": "explorer",
              "children": [
                {
                  "id": "explorer",
                  "type": "column",
                  "children": [
                    {
                      "id": "explorer-tree",
                      "type": "block",
                      "content": {
                        "mod": "vx-workspace"
                      },
                      "min": 80
                    },
                    {
                      "id": "plans",
                      "type": "block",
                      "content": {
                        "mod": "vx-files",
                        "props": {
                          "section": "plans",
                          "block": "plans"
                        }
                      },
                      "size": {
                        "px": 22
                      },
                      "min": 22
                    },
                    {
                      "id": "timeline",
                      "type": "block",
                      "content": {
                        "mod": "vx-files",
                        "props": {
                          "section": "timeline",
                          "block": "timeline"
                        }
                      },
                      "size": {
                        "px": 22
                      },
                      "min": 22
                    },
                    {
                      "id": "npm",
                      "type": "block",
                      "content": {
                        "mod": "vx-scripts",
                        "props": {
                          "section": "npm",
                          "block": "npm"
                        }
                      },
                      "size": {
                        "px": 22
                      },
                      "min": 22
                    }
                  ]
                },
                {
                  "id": "search",
                  "type": "block",
                  "content": {
                    "mod": "vx-search"
                  }
                },
                {
                  "id": "scm",
                  "type": "block",
                  "content": {
                    "mod": "vx-changes"
                  }
                },
                {
                  "id": "ci",
                  "type": "block",
                  "content": {
                    "mod": "vx-ci",
                    "props": {
                      "panel": true
                    }
                  }
                },
                {
                  "id": "docker",
                  "type": "block",
                  "content": {
                    "mod": "vx-docker"
                  }
                },
                {
                  "id": "http",
                  "type": "block",
                  "content": {
                    "mod": "vx-http"
                  }
                },
                {
                  "id": "spaces",
                  "type": "block",
                  "content": {
                    "mod": "spaces"
                  }
                },
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "agents"
                  }
                }
              ]
            }
          ],
          "radius": 12,
          "border": {
            "width": 1,
            "color": "raised"
          },
          "padding": 4
        },
        {
          "id": "work",
          "type": "column",
          "padding": [
            0,
            6
          ],
          "gap": 6,
          "children": [
            {
              "id": "editor",
              "type": "column",
              "resizable": false,
              "background": "background",
              "radius": 12,
              "border": {
                "width": 1,
                "color": "raised"
              },
              "children": [
                {
                  "id": "tabs",
                  "type": "block",
                  "content": {
                    "mod": "vx-tabs",
                    "props": {
                      "style": "vscode"
                    }
                  },
                  "size": {
                    "px": 35
                  }
                },
                {
                  "id": "breadcrumbs",
                  "type": "block",
                  "content": {
                    "mod": "vx-tabs",
                    "props": {
                      "breadcrumbs": true
                    }
                  },
                  "size": {
                    "px": 24
                  }
                },
                {
                  "id": "editor-body",
                  "type": "column",
                  "padding": [
                    4,
                    4
                  ],
                  "children": [
                    {
                      "id": "main",
                      "type": "block",
                      "content": {
                        "tab": "active",
                        "pane": {
                          "header": {
                            "content": {
                              "mod": "pane"
                            },
                            "reveal": "hover",
                            "height": 26,
                            "position": "top"
                          },
                          "background": "background",
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "focus": {
                            "width": 1,
                            "color": "accent"
                          },
                          "radius": 0,
                          "gap": 0,
                          "lone": false
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "bottom",
              "type": "column",
              "size": {
                "px": 260
              },
              "min": 100,
              "hidden": true,
              "resizable": false,
              "background": "background",
              "radius": 12,
              "border": {
                "width": 1,
                "color": "raised"
              },
              "children": [
                {
                  "id": "panel-head",
                  "type": "block",
                  "content": {
                    "mod": "vx-panel"
                  },
                  "size": {
                    "px": 34
                  }
                },
                {
                  "id": "term",
                  "type": "block",
                  "content": {
                    "mod": "vx-panel",
                    "props": {
                      "empty": true
                    }
                  }
                }
              ],
              "padding": 4
            }
          ]
        },
        {
          "id": "chat",
          "type": "column",
          "size": {
            "px": 400
          },
          "min": 300,
          "max": 760,
          "hidden": true,
          "background": "chrome",
          "radius": 12,
          "border": {
            "width": 1,
            "color": "raised"
          },
          "padding": 4,
          "children": [
            {
              "id": "chat-view",
              "type": "block",
              "content": {
                "mod": "vx-chat"
              }
            }
          ]
        }
      ],
      "padding": [
        2,
        0
      ]
    },
    {
      "id": "status",
      "type": "block",
      "content": {
        "mod": "vx-status",
        "props": {
          "style": "vscode"
        }
      },
      "size": {
        "px": 24
      }
    }
  ]
}
